# Keep the API image small and secrets out of it
**/node_modules
**/.next
**/.expo
**/dist
**/.turbo
**/.env
**/.env.*
!**/.env.example
.git
docs

# Mobile app: only its package.json is needed (pnpm frozen lockfile).
# The API and the panel images copy only the folders they use.
apps/mobile/*
!apps/mobile/package.json
