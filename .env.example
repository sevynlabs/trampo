# ===========================================
# TRAMPO - Environment Variables Template
# ===========================================
# COPY this file to .env and fill in real values
# NEVER commit .env to git
# ===========================================

# ---- Database (Supabase) ----
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ---- Supabase ----
SUPABASE_URL="https://[PROJECT].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."  # BACKEND ONLY - Never expose to mobile

# ---- Asaas (Payments) ----
ASAAS_API_KEY="$aact_..."
ASAAS_WEBHOOK_TOKEN="your-webhook-secret"
ASAAS_ENVIRONMENT="sandbox"  # sandbox | production

# ---- Twilio (OTP) ----
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_VERIFY_SERVICE_SID="VA..."

# ---- Redis (Upstash) ----
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ---- Encryption ----
PII_ENCRYPTION_KEY="32-char-random-string-here!!"  # Generate with: openssl rand -hex 16

# ---- Push Notifications (Firebase) ----
FCM_SERVER_KEY="..."

# ---- Email (Resend) ----
RESEND_API_KEY="re_..."

# ---- App Config ----
NODE_ENV="development"
API_PORT="3000"
API_URL="http://localhost:3000"
CORS_ORIGIN="*"  # Restrict in production

# ---- JWT ----
JWT_SECRET="another-32-char-random-string!!"  # Generate with: openssl rand -hex 16
