{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "../..",
    "paths": {
      "@/*": [
        "./apps/mobile/src/*"
      ],
      "@trampo/api/src/*": [
        "./apps/api/src/*"
      ],
      "@trampo/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@trampo/db": [
        "./packages/db/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}