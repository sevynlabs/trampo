{
  "name": "trampo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@trampo/api",
    "dev:mobile": "turbo dev --filter=@trampo/mobile",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @trampo/db generate",
    "db:push": "pnpm --filter @trampo/db push",
    "db:migrate": "pnpm --filter @trampo/db migrate",
    "db:studio": "pnpm --filter @trampo/db studio",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "copy-anything": "^4.0.5"
  }
}
