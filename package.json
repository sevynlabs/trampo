{
  "name": "trampo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@trampo/api",
    "dev:mobile": "turbo dev --filter=@trampo/mobile",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @trampo/db generate",
    "db:push": "pnpm --filter @trampo/db push",
    "db:migrate": "pnpm --filter @trampo/db migrate",
    "db:studio": "pnpm --filter @trampo/db studio",
    "db:seed": "pnpm --filter @trampo/db seed",
    "clean": "turbo clean && rm -rf node_modules",
    "db:migrate:deploy": "pnpm --filter @trampo/db migrate:deploy"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@expo/dom-webview": "~58.0.2",
      "@react-native/metro-config": "0.88.1"
    }
  },
  "devDependencies": {
    "railway": "^3.17.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "copy-anything": "^4.0.5"
  }
}
