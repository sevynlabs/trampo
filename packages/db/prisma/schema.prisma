generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, postgis]
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CLIENT
  TASKER
  BOTH
}

enum KycStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum TaskStatus {
  OPEN
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  RELEASED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  HELD
  RELEASED
  REFUNDED
  DISPUTED
  EXPIRED
}

enum DisputeStatus {
  OPEN
  RESOLVED_RELEASED // Admin resolved in favor of the tasker (escrow released)
  RESOLVED_REFUNDED // Admin resolved in favor of the client (payment refunded)
}

enum AdminRole {
  SUPER_ADMIN // Full access, can manage other admins
  OPERATOR // Day-to-day ops: KYC review, user management
  VIEWER // Read-only access
}

enum CampaignChannel {
  PUSH
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
}

// ============================================
// MODELS
// ============================================

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone        String   @unique
  cpfEncrypted Bytes?   @map("cpf_encrypted") // Encrypted with pgcrypto
  cpfHash      String?  @unique @map("cpf_hash") // For lookups
  name         String?
  email        String?
  avatarUrl    String?  @map("avatar_url")
  /// Public in-app ID shown on the shareable profile card (e.g. "TR4F9A2C",
  /// displayed as "TR-4F9A2C"). Never a contact — just a handle to search for.
  publicCode   String   @unique @default(dbgenerated("('TR'::text || upper(substr(md5(((random())::text || (clock_timestamp())::text)), 1, 6)))")) @map("public_code")
  role         UserRole @default(CLIENT)
  pushToken    String?  @map("push_token") // Expo push token
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  taskerProfile   TaskerProfile?
  identity        IdentityVerification?
  tasksAsClient   Task[]                @relation("ClientTasks")
  assignments     TaskAssignment[]
  sentMessages    Message[]             @relation("SentMessages")
  reviewsGiven    Review[]              @relation("ReviewsGiven")
  reviewsReceived Review[]              @relation("ReviewsReceived")
  payments        Payment[]
  notifications   Notification[]

  @@map("users")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String // e.g. task_accepted, payment_confirmed, new_message
  title     String
  body      String
  data      Json? // arbitrary payload for deep-linking
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model TaskerProfile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  bio             String?
  kycStatus       KycStatus @default(PENDING) @map("kyc_status")
  kycSubmittedAt  DateTime? @map("kyc_submitted_at")
  kycApprovedAt   DateTime? @map("kyc_approved_at")
  kycRejectedAt   DateTime? @map("kyc_rejected_at")
  kycRejectReason String?   @map("kyc_reject_reason")

  // Professional verification: kycStatus/kycSubmittedAt/... now track the
  // review of the criminal-record certificate (only for professionals).
  // The identity documents moved to IdentityVerification (all users); the
  // three columns below are legacy and no longer written.
  // KYC Documents (stored in Supabase Storage, only paths here)
  documentFrontPath  String? @map("document_front_path")
  documentBackPath   String? @map("document_back_path")
  selfiePath         String? @map("selfie_path")
  /// Certidão de antecedentes criminais (PDF do gov.br ou foto)
  criminalRecordPath String? @map("criminal_record_path")

  // Asaas integration
  asaasAccountId String? @unique @map("asaas_account_id")
  asaasWalletId  String? @unique @map("asaas_wallet_id")
  pixKey         String? @map("pix_key") // Tasker's Pix key for withdrawals

  // Stats
  rating        Float @default(0)
  totalTasks    Int   @default(0) @map("total_tasks")
  totalEarnings Int   @default(0) @map("total_earnings") // In centavos

  // Location for feed
  currentLocation Unsupported("geography(Point, 4326)")? @map("current_location")
  serviceRadius   Int                                    @default(10000) @map("service_radius") // In meters
  // Base city (reverse-geocoded from currentLocation in the app's "Área de atuação")
  city            String?
  state           String? // UF, e.g. "MG"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories   TaskerProfileCategory[]
  withdrawals  Withdrawal[]
  kycDecisions KycDecision[]

  @@index([currentLocation], type: Gist)
  @@map("tasker_profiles")
}

// ============================================
// ADMIN PANEL
// ============================================

model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole @default(OPERATOR)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  kycDecisions KycDecision[]
  auditLogs    AuditLog[]
  campaigns    Campaign[]

  @@map("admin_users")
}

/// A push or email campaign targeted at a dynamic user segment.
model Campaign {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  channel         CampaignChannel
  status          CampaignStatus  @default(DRAFT)
  segment         Json // dynamic filter descriptor (role, kycStatus, activeWithinDays, ...)
  title           String // push title / email subject
  body            String // push body / email html
  emailTemplateId String?         @map("email_template_id") @db.Uuid
  scheduledAt     DateTime?       @map("scheduled_at")
  sentAt          DateTime?       @map("sent_at")
  recipientCount  Int             @default(0) @map("recipient_count")
  sentCount       Int             @default(0) @map("sent_count")
  failedCount     Int             @default(0) @map("failed_count")
  createdById     String          @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  createdBy  AdminUser           @relation(fields: [createdById], references: [id])
  recipients CampaignRecipient[]

  @@index([status, createdAt])
  @@index([createdById])
  @@map("campaigns")
}

/// Per-user delivery record for a campaign (for metrics + idempotency).
model CampaignRecipient {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId String          @map("campaign_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  status     RecipientStatus @default(PENDING)
  error      String?
  sentAt     DateTime?       @map("sent_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

enum CouponKind {
  PERCENT
  FIXED
}

/// Promotional coupon / discount code.
model Coupon {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String     @unique
  kind       CouponKind
  value      Int // percent (0-100) or centavos, per kind
  maxUses    Int?       @map("max_uses")
  usedCount  Int        @default(0) @map("used_count")
  validFrom  DateTime?  @map("valid_from")
  validUntil DateTime?  @map("valid_until")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("coupons")
}

/// Advertiser banner shown in the carousel at the top of the app's home.
model AdBanner {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  advertiser  String // who is paying for the slot
  title       String // internal name + accessibility label
  imageUrl    String    @map("image_url") // ~2.4:1 landscape image
  linkUrl     String?   @map("link_url") // opened when the banner is tapped
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("ad_banners")
}

/// Key/value store for admin-managed integration toggles + config.
model IntegrationSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("integration_settings")
}

/// Reusable email template (subject + HTML body with {{variables}}).
model EmailTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  subject   String
  bodyHtml  String   @map("body_html")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

/// Generic audit trail for admin write actions (block user, pay withdrawal,
/// send campaign, role change, etc). KycDecision remains the KYC-specific log.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String // e.g. withdrawal.pay, user.block, campaign.send
  targetType String   @map("target_type") // e.g. withdrawal, user, payment
  targetId   String?  @map("target_id")
  metadata   Json? // arbitrary before/after or context payload
  createdAt  DateTime @default(now()) @map("created_at")

  actor AdminUser @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_logs")
}

/// Audit trail for KYC approve/reject decisions made by admins.
model KycDecision {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskerProfileId String    @map("tasker_profile_id") @db.Uuid
  adminId         String    @map("admin_id") @db.Uuid
  decision        KycStatus // APPROVED or REJECTED
  reason          String? // Required when rejecting
  createdAt       DateTime  @default(now()) @map("created_at")

  taskerProfile TaskerProfile @relation(fields: [taskerProfileId], references: [id], onDelete: Cascade)
  admin         AdminUser     @relation(fields: [adminId], references: [id])

  @@index([taskerProfileId, createdAt])
  @@index([adminId])
  @@map("kyc_decisions")
}

enum WithdrawalStatus {
  PENDING
  PAID
  FAILED
}

model Withdrawal {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskerProfileId String           @map("tasker_profile_id") @db.Uuid
  amount          Int // centavos
  pixKey          String           @map("pix_key")
  status          WithdrawalStatus @default(PENDING)
  asaasTransferId String?          @map("asaas_transfer_id")
  failureReason   String?          @map("failure_reason")
  createdAt       DateTime         @default(now()) @map("created_at")
  paidAt          DateTime?        @map("paid_at")

  taskerProfile TaskerProfile @relation(fields: [taskerProfileId], references: [id], onDelete: Cascade)

  @@index([taskerProfileId, createdAt])
  @@map("withdrawals")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  name        String
  icon        String? // Icon name for mobile app
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  tasks          Task[]
  taskerProfiles TaskerProfileCategory[]

  @@map("categories")
}

model TaskerProfileCategory {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskerProfileId String @map("tasker_profile_id") @db.Uuid
  categoryId      String @map("category_id") @db.Uuid

  taskerProfile TaskerProfile @relation(fields: [taskerProfileId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([taskerProfileId, categoryId])
  @@index([categoryId])
  @@map("tasker_profile_categories")
}

model Task {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId   String @map("client_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  title       String
  description String?

  // Location
  address  String
  location Unsupported("geography(Point, 4326)")

  // Scheduling
  scheduledAt DateTime? @map("scheduled_at")
  isUrgent    Boolean   @default(false) @map("is_urgent") // <1h = +30%

  // Pricing (all in centavos)
  baseValue   Int @map("base_value") // Original value
  urgencyFee  Int @default(0) @map("urgency_fee") // +30% if urgent
  serviceFee  Int @map("service_fee") // 5% client fee
  totalValue  Int @map("total_value") // What client pays
  taskerValue Int @map("tasker_value") // What tasker receives (after 15%)

  status TaskStatus @default(OPEN)

  // Timestamps
  acceptedAt  DateTime? @map("accepted_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  releasedAt  DateTime? @map("released_at")
  cancelledAt DateTime? @map("cancelled_at")
  disputedAt  DateTime? @map("disputed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  client     User            @relation("ClientTasks", fields: [clientId], references: [id])
  category   Category        @relation(fields: [categoryId], references: [id])
  assignment TaskAssignment?
  messages   Message[]
  reviews    Review[]
  payment    Payment?
  dispute    Dispute?

  @@index([location], type: Gist)
  @@index([status, createdAt])
  @@index([clientId])
  @@index([categoryId])
  @@map("tasks")
}

model TaskAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @unique @map("task_id") @db.Uuid
  taskerId  String   @map("tasker_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tasker User @relation(fields: [taskerId], references: [id])

  @@index([taskerId])
  @@map("task_assignments")
}

model Message {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender User @relation("SentMessages", fields: [senderId], references: [id])

  @@index([taskId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  rating     Int // 1-5
  comment    String?
  tags       String[] // ["Pontual", "Caprichoso", etc]
  createdAt  DateTime @default(now()) @map("created_at")

  // Moderation: hidden reviews are kept but excluded from public listings
  // and from the reviewee's rating.
  hiddenAt     DateTime? @map("hidden_at")
  hiddenReason String?   @map("hidden_reason")

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id])

  @@unique([taskId, reviewerId]) // One review per user per task
  @@index([revieweeId])
  @@index([createdAt])
  @@index([reviewerId])
  @@map("reviews")
}

model Payment {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId String @unique @map("task_id") @db.Uuid
  userId String @map("user_id") @db.Uuid // The payer (client)

  // Asaas
  asaasId         String? @unique @map("asaas_id") // For idempotency
  asaasPaymentId  String? @map("asaas_payment_id")
  asaasTransferId String? @unique @map("asaas_transfer_id") // Set once escrow is transferred to the tasker
  pixCode         String? @map("pix_code")
  pixQrCode       String? @map("pix_qr_code")

  // Values (centavos)
  amount       Int // Total charged
  platformFee  Int @map("platform_fee") // 20% total (15% tasker + 5% client)
  taskerAmount Int @map("tasker_amount") // What tasker receives

  status PaymentStatus @default(PENDING)

  paidAt     DateTime? @map("paid_at")
  heldAt     DateTime? @map("held_at")
  releasedAt DateTime? @map("released_at")
  refundedAt DateTime? @map("refunded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
  @@map("payments")
}

model Cancellation {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId        String  @map("task_id") @db.Uuid
  cancelledById String  @map("cancelled_by_id") @db.Uuid
  reason        String?

  // Penalty (centavos)
  penaltyAmount Int     @default(0) @map("penalty_amount")
  wasPenalized  Boolean @default(false) @map("was_penalized")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("cancellations")
}

model Dispute {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String        @unique @map("task_id") @db.Uuid
  openedById String        @map("opened_by_id") @db.Uuid
  reason     String
  status     DisputeStatus @default(OPEN)

  // Admin resolution
  resolution   String? // Free-text notes from the admin
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("disputes")
}

// ============================================
// SERVICE AREAS (for regional coverage)
// ============================================

model ServiceArea {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String // Uberlandia, Uberaba, Araguari
  slug     String  @unique
  isActive Boolean @default(true) @map("is_active")

  // Polygon for the service area
  boundary Unsupported("geography(Polygon, 4326)")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([boundary], type: Gist)
  @@map("service_areas")
}

/// Minimum verification for EVERY user (client or professional):
/// identity document + selfie holding it. Sending is enough to post and hire;
/// professionals additionally need it APPROVED plus the criminal record.
model IdentityVerification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  documentFrontPath String?   @map("document_front_path")
  documentBackPath  String?   @map("document_back_path")
  selfiePath        String?   @map("selfie_path")
  status            KycStatus @default(PENDING)
  submittedAt       DateTime? @map("submitted_at")
  approvedAt        DateTime? @map("approved_at")
  rejectedAt        DateTime? @map("rejected_at")
  rejectReason      String?   @map("reject_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@map("identity_verifications")
}
